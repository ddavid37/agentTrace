# AgentTrace local configuration.
# Copy to .env if you need to override defaults.
# Do not put real credentials in this file.

# Reserved for a future model-backed agent. The current mock agent
# does not call any external API.
AGENTTRACE_MODEL_PROVIDER=
AGENTTRACE_MODEL_NAME=
AGENTTRACE_API_KEY=

# Optional: default policy behavior when a detector returns REQUIRE_APPROVAL.
# Values: deny | allow
AGENTTRACE_APPROVAL_MODE=deny
